{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://professional-ai-agents.local/schemas/external-import-record.schema.json",
  "title": "External Professional Core Import Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "import_id",
    "source",
    "rights",
    "security_review",
    "provenance_evidence",
    "imported_scope",
    "local_transformations",
    "admission_disposition"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "import_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri", "revision", "retrieved_at"],
      "properties": {
        "type": {"enum": ["git-repository", "package", "skill-registry", "artifact-registry", "other"]},
        "uri": {"type": "string", "minLength": 3},
        "revision": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_or_terms", "reuse_allowed", "redistribution_allowed", "attribution_requirements", "unresolved_constraints"],
      "properties": {
        "license_or_terms": {"type": "string", "minLength": 1},
        "reuse_allowed": {"type": ["boolean", "null"]},
        "redistribution_allowed": {"type": ["boolean", "null"]},
        "attribution_requirements": {"type": "array", "items": {"type": "string"}},
        "unresolved_constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "security_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["untrusted_instructions_checked", "executable_content_checked", "secret_or_network_risk_checked", "findings"],
      "properties": {
        "untrusted_instructions_checked": {"type": "boolean"},
        "executable_content_checked": {"type": "boolean"},
        "secret_or_network_risk_checked": {"type": "boolean"},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "imported_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}}
      }
    },
    "local_transformations": {"type": "array", "items": {"type": "string"}},
    "admission_disposition": {"enum": ["inspect-only", "candidate", "rejected", "quarantined"]}
  }
}
