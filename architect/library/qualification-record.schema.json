{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://professional-ai-agents.local/schemas/qualification-record.schema.json",
  "title": "Professional Core Qualification Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "core_id",
    "core_version",
    "artifact_digest",
    "status",
    "claims",
    "evaluation",
    "environment",
    "evidence",
    "limitations",
    "freshness",
    "qualified_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3
    },
    "core_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "core_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "pass",
        "conditional-pass",
        "fail",
        "revoked",
        "expired"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "criticality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 3
          },
          "criticality": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_refs",
        "grader_refs",
        "thresholds",
        "reliability_trials",
        "result"
      ],
      "properties": {
        "fixture_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "grader_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reliability_trials": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "model_or_executor",
        "tools",
        "state_contract",
        "authority_scope"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "model_or_executor": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state_contract": {
          "type": "string",
          "minLength": 1
        },
        "authority_scope": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "description": "Exact model identifier, when the record pins one.",
          "type": "string",
          "minLength": 1
        },
        "thinking_level": {
          "description": "Provider reasoning-effort setting used for the scored run.",
          "type": "string",
          "minLength": 1
        },
        "qualification_transport": {
          "description": "API/transport the scored run went through.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_refs",
        "artifact_refs",
        "provenance_refs"
      ],
      "properties": {
        "run_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "provenance_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "single_decision_heldout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixture",
            "workflow_run_id",
            "passes",
            "hard_failures"
          ],
          "properties": {
            "fixture": {
              "type": "string",
              "minLength": 1
            },
            "cases": {
              "type": "integer",
              "minimum": 1
            },
            "case_id": {
              "type": "string",
              "minLength": 1
            },
            "trials": {
              "type": "integer",
              "minimum": 1
            },
            "trials_per_case": {
              "type": "integer",
              "minimum": 1
            },
            "planned_case_evaluations": {
              "type": "integer",
              "minimum": 1
            },
            "passes": {
              "type": "integer",
              "minimum": 0
            },
            "hard_failures": {
              "type": "integer",
              "minimum": 0
            },
            "mismatches": {
              "type": "integer",
              "minimum": 0
            },
            "workflow_run_id": {
              "type": "integer",
              "minimum": 1
            },
            "successful_artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "note": {
              "type": "string",
              "minLength": 3
            }
          },
          "description": "Per-gate detail for the single-decision held-out gate."
        },
        "fresh_practical_work_sample": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixture",
            "workflow_run_id",
            "passes",
            "hard_failures"
          ],
          "properties": {
            "fixture": {
              "type": "string",
              "minLength": 1
            },
            "cases": {
              "type": "integer",
              "minimum": 1
            },
            "case_id": {
              "type": "string",
              "minLength": 1
            },
            "trials": {
              "type": "integer",
              "minimum": 1
            },
            "trials_per_case": {
              "type": "integer",
              "minimum": 1
            },
            "planned_case_evaluations": {
              "type": "integer",
              "minimum": 1
            },
            "passes": {
              "type": "integer",
              "minimum": 0
            },
            "hard_failures": {
              "type": "integer",
              "minimum": 0
            },
            "mismatches": {
              "type": "integer",
              "minimum": 0
            },
            "workflow_run_id": {
              "type": "integer",
              "minimum": 1
            },
            "successful_artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "note": {
              "type": "string",
              "minLength": 3
            }
          },
          "description": "Per-gate detail for the fresh end-to-end practical work sample."
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validity_boundary",
        "revalidation_triggers"
      ],
      "properties": {
        "validity_boundary": {
          "type": "string",
          "minLength": 3
        },
        "revalidation_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qualified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "description": "Legacy mirror of evaluation.result kept on records authored before the evaluation block existed. When present it must agree with evaluation.result.",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "qualified_assembly": {
      "description": "Exact frozen component assembly the qualification was run against, pinned by Git blob SHA.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly_id",
        "assembly_digest",
        "components"
      ],
      "properties": {
        "assembly_id": {
          "type": "string",
          "minLength": 1
        },
        "assembly_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "git_blob_sha"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "git_blob_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        }
      }
    },
    "critical_claims_passed": {
      "description": "Free-text statements of the critical claims observed to pass. Narrative companion to claims[]; it does not replace it.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "known_nonqualifying_history": {
      "description": "Earlier attempts deliberately preserved as non-qualifying rather than relabelled as PASS.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
