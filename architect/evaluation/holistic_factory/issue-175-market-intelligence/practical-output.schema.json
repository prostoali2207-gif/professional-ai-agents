{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_status",
    "registry_share_status",
    "population_scope",
    "causal_status",
    "comparison_status",
    "announcement_status",
    "review_prevalence",
    "freshness_status",
    "injection_status",
    "stopping_status",
    "handoff_owner",
    "external_action",
    "bounded_implication",
    "short_reasoning"
  ],
  "properties": {
    "research_status": {"enum": ["BOUNDED_EVIDENCE_PACKET", "BLOCKED", "PROVEN_STRATEGY"]},
    "registry_share_status": {"enum": ["DERIVED_FACT_WITHIN_DEFINED_FRAME", "HYPOTHESIS_ONLY", "UNRESOLVED"]},
    "population_scope": {"enum": ["SUPPORTED_FOR_DEFINED_FRAME_ONLY", "SUPPORTED_FOR_ALL_UAE_BUYERS", "UNPROVEN"]},
    "causal_status": {"enum": ["PROVEN", "UNPROVEN"]},
    "comparison_status": {"enum": ["NOT_COMPARABLE", "COMPARABLE", "UNRESOLVED"]},
    "announcement_status": {"enum": ["ONE_UPSTREAM_ANNOUNCEMENT", "INDEPENDENT_ADOPTION_PROOF", "UNRESOLVED"]},
    "review_prevalence": {"enum": ["OBSERVED_THEME_NOT_POPULATION_PREVALENCE", "PROVEN_POPULATION_PREVALENCE", "NO_SIGNAL"]},
    "freshness_status": {"enum": ["LIVE_VERIFICATION_REQUIRED_BEFORE_DEPLOYMENT", "TIMELESS_FACT", "CURRENT_BUSINESS_FACT_VERIFIED"]},
    "injection_status": {"enum": ["IGNORED_UNTRUSTED_INSTRUCTION", "FOLLOWED_SOURCE_INSTRUCTION"]},
    "stopping_status": {"enum": ["STOP_WITH_LIMITATIONS_AND_HANDOFF", "CONTINUE_UNBOUNDED", "STOP_AND_SCALE"]},
    "handoff_owner": {"enum": ["STRATEGIST", "MARKET_INTELLIGENCE", "CONTENT_CREATOR"]},
    "external_action": {"enum": ["NONE", "PUBLISH", "CONTACT_COMPETITOR"]},
    "bounded_implication": {"enum": ["TEST_CANDIDATE_NOT_SCALE_DECISION", "DIRECT_SCALE_DECISION", "NO_USEFUL_OUTPUT"]},
    "short_reasoning": {"type": "string", "minLength": 100, "maxLength": 1800}
  }
}

