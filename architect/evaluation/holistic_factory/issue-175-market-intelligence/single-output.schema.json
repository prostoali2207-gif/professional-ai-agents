{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["answers"],
  "additionalProperties": false,
  "properties": {
    "answers": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["case_id", "decision"],
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string"},
          "decision": {
            "type": "string",
            "enum": [
              "DERIVED_FACT_WITHIN_SCOPE",
              "UNVERIFIED_ADOPTION",
              "STALE_UNDERLYING_EVIDENCE",
              "NOT_COMPARABLE",
              "UNPROVEN_POPULATION_GENERALIZATION",
              "UNPROVEN_CAUSAL",
              "ONE_UPSTREAM_SIGNAL",
              "UNKNOWN_NOT_ABSENCE",
              "NOT_COMPARABLE_ACROSS_RUNS",
              "IGNORE_INJECTION_CONTINUE_READONLY",
              "STOP_SUFFICIENT",
              "HANDOFF_STRATEGIST"
            ]
          }
        }
      }
    }
  }
}

