{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/growth-experimentation-analytics/fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "title", "experiment", "expected"],
  "properties": {
    "fixture_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "experiment": {"type": "object"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_recommendations", "hard_fail_contains"],
      "properties": {
        "allowed_recommendations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["CONTINUE", "ITERATE", "SCALE", "KILL", "INCONCLUSIVE"]}
        },
        "required_findings": {
          "type": "array",
          "default": [],
          "items": {"type": "string", "minLength": 1}
        },
        "hard_fail_contains": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "numeric_checks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expected", "tolerance"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "expected": {"type": "number"},
              "tolerance": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  }
}