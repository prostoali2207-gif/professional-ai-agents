{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/growth-experimentation-analytics/result-v2.schema.json",
  "title": "Analytics candidate output contract v2",
  "description": "v1 plus a structured decision_record. Every qualified P0/P1 claim must be observable as decision content in decision_record, not inferred from prose. Prose fields remain for human review and are not the evidence surface for behavioral grading.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "recommendation", "decision_record", "data_integrity_findings", "computations", "claim_boundaries", "confounders", "rationale", "next_action"],
  "properties": {
    "fixture_id": {"type": "string", "minLength": 1},
    "recommendation": {"enum": ["CONTINUE", "ITERATE", "SCALE", "KILL", "INCONCLUSIVE"]},

    "decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["causal", "operational", "scale_readiness"],
      "properties": {

        "causal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "claim_ceiling", "blocking_confounders"],
          "properties": {
            "status": {
              "enum": ["IDENTIFIED", "UNRESOLVED", "NOT_APPLICABLE"],
              "description": "IDENTIFIED only when the design supports attributing the outcome difference to the nominal treatment."
            },
            "claim_ceiling": {
              "enum": ["NONE", "DESCRIPTIVE_ASSOCIATION", "DIRECTIONAL_ASSOCIATION", "INCREMENTAL_CAUSAL"],
              "description": "The strongest claim the evidence supports. INCREMENTAL_CAUSAL requires a credible counterfactual."
            },
            "blocking_confounders": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "description": "Names that must also appear in confounders[].name. Ties the causal ceiling to identified evidence rather than to assertion."
            }
          }
        },

        "operational": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "target", "decision_basis", "reversible", "evidence_that_would_change_action"],
          "properties": {
            "action": {
              "enum": ["CONTINUE", "ITERATE", "SCALE", "KILL", "INCONCLUSIVE"],
              "description": "Must equal the top-level recommendation."
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "description": "Which configuration/arm the action applies to, as named by the fixture."
            },
            "decision_basis": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "REGISTERED_PRIMARY_KPI",
                  "MATURE_DOWNSTREAM_ECONOMICS",
                  "ACQUISITION_COST_DIAGNOSTIC",
                  "MATERIALITY",
                  "REVERSIBILITY",
                  "COST_OF_WAITING",
                  "CONFOUNDER_ACTION_RELEVANCE",
                  "GUARDRAIL_BREACH",
                  "CAPACITY_CONSTRAINT",
                  "INSUFFICIENT_EVIDENCE"
                ]
              },
              "description": "The grounds actually used for the operational action, from a closed vocabulary."
            },
            "reversible": {"type": "boolean"},
            "evidence_that_would_change_action": {"type": "string", "minLength": 1}
          }
        },

        "scale_readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "blocking_reasons"],
          "properties": {
            "state": {"enum": ["BLOCKED", "ELIGIBLE"]},
            "blocking_reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "UNIDENTIFIED_CAUSAL_EFFECT",
                  "MEASUREMENT_INTEGRITY_UNRESOLVED",
                  "IMMATURE_OUTCOMES",
                  "INSUFFICIENT_SAMPLE",
                  "NO_CREDIBLE_COUNTERFACTUAL",
                  "CAPACITY_OR_SATURATION_UNKNOWN",
                  "GUARDRAIL_UNVERIFIED",
                  "NOT_BLOCKED"
                ]
              },
              "description": "BLOCKED requires at least one reason other than NOT_BLOCKED."
            }
          }
        }
      }
    },

    "data_integrity_findings": {"type": "array", "items": {"type": "string"}},
    "computations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "inputs", "method", "result", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "inputs": {"type": "object"},
          "method": {"type": "string", "minLength": 1},
          "result": {"type": ["number", "string"]},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "claim_boundaries": {"type": "array", "items": {"type": "string"}},
    "confounders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "severity", "effect"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "severity": {"enum": ["NONE_OBSERVED", "LOW", "MATERIAL", "FATAL"]},
          "effect": {"type": "string"}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1}
  }
}
